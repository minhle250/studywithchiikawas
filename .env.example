# GITHUB_TOKEN: Required for GitHub Models inference (https://models.inference.ai.azure.com).
# Create a free GitHub Personal Access Token (no special scopes needed) and set it here.
GITHUB_TOKEN="MY_GITHUB_MODELS_TOKEN"

# Optional fallback OpenAI-compatible providers (used automatically if GitHub Models rate-limits):
# GROQ_API_KEY=""
# OPENROUTER_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links and API endpoints.
APP_URL="MY_APP_URL"
